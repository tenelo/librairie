# --- Django ---------------------------------------------------------------
# Développement local : config.settings.dev ; Docker / production : config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gestion.ma-librairie.ci,boutique.ma-librairie.ci
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8081,https://gestion.ma-librairie.ci,https://boutique.ma-librairie.ci
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8081
# Mettre False tant que HTTPS n'est pas configuré (test local avec docker compose).
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_COOKIES=False

# --- Base de données (sans cette variable : SQLite local) -----------------
DATABASE_URL=postgres://librairie:librairie@postgres:5432/librairie

# --- Redis : cache, Channels (WebSocket), broker Celery --------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Administrateur créé au premier démarrage ------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Changer-Ce-Mot-De-Passe-2026
ADMIN_EMAIL=admin@ma-librairie.ci

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Limitation de débit (authentification) -------------------------------
THROTTLE_AUTH=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_WEBHOOK=120/min

# --- Web Push (clés VAPID : voir README) -----------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@ma-librairie.ci

# Paiement d'un acompte en ligne : classe implémentant apps.orders.payments.PaymentProvider
# (simulation fournie par défaut ; à remplacer par l'intégration de votre agrégateur Mobile Money).
PAYMENT_PROVIDER=apps.orders.payments.SandboxProvider

# --- E-mail (rapports planifiés, notifications) ----------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Librairie <no-reply@ma-librairie.ci>

WEB_CONCURRENCY=3
LOG_LEVEL=INFO
