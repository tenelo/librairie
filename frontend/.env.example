# Développement (ng serve) : adresse du backend Django vers laquelle le proxy redirige
# /api, /ws, /uploads, /admin et /static (lu par proxy.conf.mjs).
API_PROXY_TARGET=http://127.0.0.1:8000

# Les applications appellent l'API en relatif (/api) : aucune URL n'est compilée dans le build.
# En Docker et en production, nginx sert chaque PWA et relaie /api et /ws vers le backend.
