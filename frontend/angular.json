{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "backoffice": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/backoffice",
      "sourceRoot": "projects/backoffice/src",
      "prefix": "bo",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/backoffice/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/backoffice/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/backoffice/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/roboto/300.css",
              "node_modules/@fontsource/roboto/400.css",
              "node_modules/@fontsource/roboto/500.css",
              "node_modules/@fontsource/roboto/700.css",
              "node_modules/material-icons/iconfont/filled.css",
              "projects/backoffice/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/shared/src/styles"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "projects/backoffice/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "backoffice:build:production"
            },
            "development": {
              "buildTarget": "backoffice:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200,
            "proxyConfig": "proxy.conf.mjs"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/backoffice/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/backoffice/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/roboto/300.css",
              "node_modules/@fontsource/roboto/400.css",
              "node_modules/@fontsource/roboto/500.css",
              "node_modules/@fontsource/roboto/700.css",
              "node_modules/material-icons/iconfont/filled.css",
              "projects/backoffice/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/shared/src/styles"
              ]
            }
          }
        }
      }
    },
    "boutique": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/boutique",
      "sourceRoot": "projects/boutique/src",
      "prefix": "bt",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/boutique/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/boutique/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/boutique/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/roboto/300.css",
              "node_modules/@fontsource/roboto/400.css",
              "node_modules/@fontsource/roboto/500.css",
              "node_modules/@fontsource/roboto/700.css",
              "node_modules/material-icons/iconfont/filled.css",
              "projects/boutique/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/shared/src/styles"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "projects/boutique/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "boutique:build:production"
            },
            "development": {
              "buildTarget": "boutique:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4300,
            "proxyConfig": "proxy.conf.mjs"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/boutique/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/boutique/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/roboto/300.css",
              "node_modules/@fontsource/roboto/400.css",
              "node_modules/@fontsource/roboto/500.css",
              "node_modules/@fontsource/roboto/700.css",
              "node_modules/material-icons/iconfont/filled.css",
              "projects/boutique/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/shared/src/styles"
              ]
            }
          }
        }
      }
    },
    "shared": {
      "projectType": "library",
      "root": "projects/shared",
      "sourceRoot": "projects/shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/shared/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  }
}
